# Skopiuj do .env i uzupełnij. Nie commituj .env.

# Model językowy przez OpenRouter (API zgodne z OpenAI), patrz apps/api/src/model.ts
OPENROUTER_API_KEY=
# Opcjonalnie inny dostawca zgodny z OpenAI; puste = https://openrouter.ai/api/v1
# Przykłady: https://api.mistral.ai/v1 · http://localhost:11434/v1 (Ollama)
LLM_BASE_URL=
# Format <dostawca>:<model>, np. openai-compatible:mistralai/mistral-small-3.2-24b-instruct. Do zdjęć potrzebny model multimodalny.
LLM_MODEL=
# false, jeśli dostawca nie obsługuje response_format: json_schema
LLM_STRUCTURED_OUTPUTS=true

# Tryb kroku wyszukiwania, patrz docs/agent.md: agent (pętla modelu z narzędziami) albo plan (plan zapytań + sędzia bez narzędzi)
RESEARCH_MODE=agent
# Opcjonalnie osobny model sędziego w trybie plan (format jak LLM_MODEL). Puste = LLM_MODEL
LLM_JUDGE_MODEL=
# Temperatura w trybie plan (domyślnie 0 = najbardziej powtarzalne wyniki). none = parametr nie jest wysyłany
LLM_TEMPERATURE=0
# Cena modelu w USD za milion tokenów, do zapisu kosztu sprawdzenia. Puste = zapisujemy same tokeny
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
# true = API nie startuje bez skonfigurowanego modelu (zalecane na produkcji)
REQUIRE_LLM=false

# Google Fact Check Tools API (klucz z Google Cloud), patrz packages/sources
GOOGLE_FACTCHECK_API_KEY=

# Token do EUvsDisinfo (MCP/API), patrz docs/data-sources.md
EUVSDISINFO_API_KEY=

# Kanał WhatsApp (Meta Cloud API), patrz README → Kanał WhatsApp. Kanał działa, gdy ustawione są cztery pierwsze.
# Stały token System User z uprawnieniem whatsapp_business_messaging (token z panelu API Setup wygasa po 24 h)
WHATSAPP_ACCESS_TOKEN=
# Phone Number ID z WhatsApp → API Setup (identyfikator, nie numer telefonu)
WHATSAPP_PHONE_NUMBER_ID=
# App Settings → Basic → App Secret; do weryfikacji podpisu webhooka
WHATSAPP_APP_SECRET=
# Losowy ciąg, ten sam co w WhatsApp → Configuration → Verify token
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_RATE_LIMIT_PER_MINUTE=5

# Frontend (apps/web): adres API widziany z przeglądarki. Tylko zmienne VITE_* trafiają do kodu strony.
VITE_API_URL=http://localhost:3000

# API (wartości domyślne w apps/api/src/env.ts; ścieżki względem katalogu repo)
PORT=3000
WEB_ORIGIN=http://localhost:5173
CORPUS_DB_PATH=data/corpus.db
# Snapshot korpusu (JSONL), z którego `pnpm --filter @prawdowid/sources seed` buduje bazę.
CORPUS_SNAPSHOT_PATH=data/corpus/snapshot.jsonl
CHECKS_DB_PATH=data/checks.db
MAX_CONCURRENT_CHECKS=4
MAX_QUEUED_CHECKS=50
CHECK_TIMEOUT_MS=30000
CHECKS_RETENTION_HOURS=72
# To samo zgłoszenie (w WWW i WhatsApp) dostaje przez tyle godzin kopię pełnego wyniku. 0 wyłącza.
CHECK_REUSE_HOURS=24
# Limitowanie żądań per IP (na minutę). TRUST_PROXY=true tylko za zaufanym reverse proxy (X-Forwarded-For).
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_GET_PER_MINUTE=120
TRUST_PROXY=false
