{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @prawdowid/sources seed",
    "watchPatterns": [
      "apps/api/**",
      "packages/**",
      "data/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      ".nvmrc"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @prawdowid/api start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
